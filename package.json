{
  "name": "coureregdtu",
  "version": "2.0.1",
  "description": "Course Registrar DTU",
  "main": "main.js",
  "author": {
    "name": "potui",
    "email": "potui@potui.xyz"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "selftest": "node selftest/run.js",
    "selftest:monitor": "node selftest/monitor.run.js",
    "test": "npm run selftest && npm run selftest:monitor"
  },
  "build": {
    "appId": "com.saksham.coureregdtu",
    "productName": "CourseRegistrar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.github/**",
      "!*.md",
      "!mermaid_diagram_*.png",
      "!selftest/**"
    ],
    "artifactName": "CourseRegistrar-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/dtulogo.ico"
    },
    "portable": {
      "artifactName": "CourseRegistrar-${version}-windows-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/dtulogo.png",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/dtulogo.png",
      "category": "Utility",
      "maintainer": "vineeta07"
    }
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "got": "^14.4.5",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.0.12"
  }
}
